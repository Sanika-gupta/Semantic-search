# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
# For MongoDB Atlas (recommended for deployment):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vla_research

MONGODB_DB_NAME=vla_research

# arXiv API Configuration
ARXIV_BASE_URL=https://export.arxiv.org/api/query
MAX_RESULTS=3000

# Redis Configuration (for rate limiting and caching)
REDIS_URI=redis://localhost:6379/0
# For Redis Cloud (recommended for deployment):
# REDIS_URI=redis://<username>:<password>@<host>:<port>/0

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_BURST_CAPACITY=20

# Caching Configuration (Phase 4)
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600
CACHE_MAX_SCAN=1000
